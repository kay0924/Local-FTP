# Copy to .env and edit, then run bash setup.sh
#   cp env.example .env

# ---- Web ----
# Admin login for the web page (set on first setup only; 12+ characters)
ADMIN_PASSWORD=Change-Me-Admin-123
# Name shown on the login page and browser tab
SITE_NAME=File Server
# Web page → http://<this machine's IP>:WEB_PORT
WEB_PORT=8090

# Owner of ./data and ./database — run `id` on this machine and use your uid/gid
PUID=1000
PGID=1000

# ---- FTP (optional) ----
# yes = setup.sh also starts the FTP server
FTP_ENABLED=no
# This machine's LAN IP (FTP passive mode tells clients to connect here) — `hostname -I`
HOST_IP=192.168.1.10
# FTP accounts, space-separated:  name|password|folder|uid
#   /ftp/data          = whole data folder
#   /ftp/data/Sachin   = only data/Sachin (create it first)
#   uid = PUID above.  No | or spaces in passwords.
FTP_USERS=ftpadmin|Change-Me-Ftp-123|/ftp/data|1000
FTP_PASV_MIN=21000
FTP_PASV_MAX=21010
